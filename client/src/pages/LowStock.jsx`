import React, { useEffect, useState } from 'react';
import API from '../api/api';
import { Link } from 'react-router-dom';
import { AlertTriangle } from 'lucide-react';

const LowStock = () => {
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchLowStock = async () => {
      try {
        const { data } = await API.get('/items/low-stock');
        setItems(data);
      } catch (err) {
        console.error('Error fetching low stock items', err);
      } finally {
        setLoading(false);
      }
    };
    fetchLowStock();
  }, []);

  return (
    <div className="p-4 md:p-8">
      <div className="flex items-center gap-3 mb-8">
        <div className="p-2 bg-red-100 text-red-600 rounded-full">
          <AlertTriangle size={24} />
        </div>
        <div>
          <h1 className="text-xl md:text-2xl font-bold text-slate-800">Low Stock Alerts</h1>
          <p className="text-sm md:text-base text-slate-500">Items that have fallen below their reorder threshold</p>
        </div>
      </div>

      {loading ? (
        <div className="text-center py-12 text-slate-400">Loading alerts...</div>
      ) : items.length === 0 ? (
        <div className="text-center py-12 text-slate-400">No low stock items. All good!</div>
      ) : (
        <>
          {/* Desktop Table View */}
          <div className="hidden md:block card overflow-hidden">
            <table className="w-full text-left">
              <thead className="bg-slate-50 text-slate-500 text-xs uppercase font-medium">
                <tr className="border-b border-slate-200">
                  <th className="px-6 py-3">SKU</th>
                  <th className="px-6 py-3">Item Name</th>
                  <th className="px-6 py-3">Current Qty</th>
                  <th className="px-6 py-3">Threshold</th>
                  <th className="px-6 py-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-200 text-sm">
                {items.map((item) => (
                  <tr key={item._id} className="hover:bg-red-50 transition-colors">
                    <td className="px-6 py-4 font-mono text-xs text-slate-500">{item.sku}</td>
                    <td className="px-6 py-4 font-medium text-slate-800">{item.name}</td>
                    <td className="px-6 py-4 text-red-600 font-bold">{item.quantity}</td>
                    <td className="px-6 py-4 text-slate-600">{item.reorderThreshold}</td>
                    <td className="px-6 py-4 text-right">
                      <Link to={`/items/${item._id}`} className="px-4 py-2 rounded font-medium transition-colors duration-200 flex items-center justify-center gap-2 bg-slate-200 text-slate-700 hover:bg-slate-300 text-xs py-1 px-3">
                        Restock
                      </Link>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Mobile Card View */}
          <div className="grid grid-cols-1 gap-4 md:hidden">
            {items.map((item) => (
              <div key={item._id} className="bg-white border border-slate-200 rounded-lg p-4 shadow-sm space-y-3">
                <div className="flex justify-between items-start">
                  <div>
                    <p className="text-xs font-mono text-slate-400">{item.sku}</p>
                    <h3 className="font-bold text-slate-800">{item.name}</h3>
                  </div>
                  <Link to={`/items/${item._id}`} className="px-3 py-1 bg-slate-200 text-slate-700 rounded text-xs font-medium hover:bg-slate-300">
                    Restock
                  </Link>
                </div>
                <div className="flex justify-between items-center pt-2 border-t border-slate-100">
                  <div className="flex flex-col">
                    <span className="text-xs text-slate-500">Current Stock</span>
                    <span className="text-lg font-bold text-red-600">{item.quantity}</span>
                  </div>
                  <div className="flex flex-col text-right">
                    <span className="text-xs text-slate-500">Threshold</span>
                    <span className="text-lg font-medium text-slate-700">{item.reorderThreshold}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  );
};

export default LowStock;
